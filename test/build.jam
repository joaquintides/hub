require-b2 5.0.1 ;
import-search /boost/config/checks ;

import testing ;
import config : requires ;

project
    : requirements
      <library>/boost/hub//boost_hub
      <library>/boost/config//boost_config
      <library>/boost/core//boost_core
      <library>/boost/interprocess//boost_interprocess
      <library>/boost/uuid//boost_uuid
      <toolset>msvc:<cxxflags>-D_SCL_SECURE_NO_WARNINGS
      <target-os>cygwin:<define>_XOPEN_SOURCE=600
      <warnings>extra
      <toolset>intel:<warnings>on
    ;

local warnings_as_errors =
    <toolset>msvc:<warnings-as-errors>on
    <toolset>clang:<warnings-as-errors>on
    <toolset>gcc:<warnings-as-errors>on
;

run test_api.cpp            : : : $(warnings_as_errors) ;
run test_pocxx.cpp          : : : $(warnings_as_errors) ;
run test_sort.cpp           : : : $(warnings_as_errors) ;
run test_stability.cpp      : : : $(warnings_as_errors) ;
run test_uses_allocator.cpp : : : $(warnings_as_errors) ;
